# Cognito Hosted UI domain, without scheme (e.g. monethical-prod.auth.eu-west-1.amazoncognito.com)
VITE_COGNITO_DOMAIN=
# App client id of the console (public client, PKCE, no secret)
VITE_COGNITO_CLIENT_ID=
# Console API base. CloudFront routes /api/* to the API and strips the prefix.
VITE_API_BASE=/api
# Edge distribution serving /w/loader.js and /config/*; used by the embed snippet
VITE_EDGE_URL=https://edge.example.com
